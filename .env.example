# Get a free API key at https://rawg.io/apidocs
RAWG_API_KEY=your_rawg_api_key_here

# Optional overrides (defaults shown)
# DATABASE_URL=sqlite:///./gametracker.db
# LOG_LEVEL=INFO
# HTTP_TIMEOUT_SECONDS=10
# HTTP_RETRIES=2

# RAWG quota conservation — how long to reuse data before asking RAWG again
# GAME_REFRESH_DAYS=30          # stored game details
# CACHE_TTL_SEARCH=86400        # search results (seconds, 24h)
# CACHE_TTL_LIST=86400          # browse/top lists (seconds, 24h)
# CACHE_TTL_CATALOG=604800      # genre/platform catalogs (seconds, 7d)
# CACHE_TTL_GAME=2592000        # raw game payload cache (seconds, 30d)
