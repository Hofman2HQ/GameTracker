<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:conv="clr-namespace:MyGameCatalog.Converters"
             x:Class="MyGameCatalog.Views.AddGamePage"
             Title="Add Game">
  <ContentPage.Resources>
    <ResourceDictionary>
      <conv:NullToBoolConverter x:Key="NullToBoolConverter"/>
      <conv:StringToBoolConverter x:Key="StringToBoolConverter"/>
    </ResourceDictionary>
  </ContentPage.Resources>
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto"
        Padding="10"
        RowSpacing="10">
    <!-- Search Section -->
    <Frame Grid.Row="0" 
           BorderColor="LightGray"
           Padding="10">
      <SearchBar Placeholder="Search for a game..."
                 Text="{Binding SearchQuery}"
                 SearchCommand="{Binding SearchCommand}"
                 SearchCommandParameter="{Binding SearchQuery}" />
    </Frame>
    <!-- Selected Game Preview -->
    <Frame Grid.Row="1"
           IsVisible="{Binding SelectedGame, Converter={StaticResource NullToBoolConverter}}"
           BorderColor="LightGray"
           Padding="10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Image Source="{Binding SelectedGame.CoverArtUrl}"
               WidthRequest="80"
               HeightRequest="80"
               Aspect="AspectFill"/>
        <StackLayout Grid.Column="1" 
                    Margin="10,0">
          <Label Text="{Binding SelectedGame.Title}"
                 FontAttributes="Bold"
                 FontSize="16"/>
          <Label Text="{Binding SelectedGame.Description}"
                 LineBreakMode="TailTruncation"
                 MaxLines="2"
                 TextColor="Gray"/>
        </StackLayout>
        <Button Grid.Column="2"
                Text="Clear"
                Command="{Binding ClearSelectionCommand}"
                VerticalOptions="Center"/>
      </Grid>
    </Frame>
    <!-- Suggestions List -->
    <CollectionView Grid.Row="2"
                   ItemsSource="{Binding Suggestions}"
                   SelectionMode="Single"
                   SelectedItem="{Binding SelectedGame}">
      <CollectionView.EmptyView>
        <StackLayout VerticalOptions="Center" 
                    HorizontalOptions="Center">
          <Label Text="No games found"
                 HorizontalOptions="Center"
                 TextColor="Gray"/>
        </StackLayout>
      </CollectionView.EmptyView>
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Frame Margin="5" 
                 Padding="10" 
                 BorderColor="LightGray">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Image Source="{Binding CoverArtUrl}"
                     WidthRequest="60"
                     HeightRequest="60"
                     Aspect="AspectFill"/>
              <StackLayout Grid.Column="1" 
                          Margin="10,0">
                <Label Text="{Binding Title}"
                       FontAttributes="Bold"/>
                <Label Text="{Binding Description}"
                       LineBreakMode="TailTruncation"
                       MaxLines="2"
                       TextColor="Gray"
                       FontSize="Small"/>
              </StackLayout>
              <Button Grid.Column="2"
                      Text="Select"
                      Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectGameCommand}"
                      CommandParameter="{Binding}"
                      VerticalOptions="Center"/>
            </Grid>
          </Frame>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
    <!-- Error Message -->
    <Frame Grid.Row="3"
           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
           BackgroundColor="#FFE0E0"
           BorderColor="#FF8080"
           Padding="10">
      <Label Text="{Binding ErrorMessage}"
             TextColor="Red"/>
    </Frame>
    <!-- Add Button and Loading State -->
    <Grid Grid.Row="4">
      <Button Text="Add to Catalog"
              Command="{Binding AddGameCommand}"
              IsEnabled="{Binding SelectedGame, Converter={StaticResource NullToBoolConverter}}"
              IsVisible="{Binding !IsBusy}"
              Margin="0,10,0,0"/>
      <ActivityIndicator IsRunning="True"
                       IsVisible="{Binding IsBusy}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
    </Grid>
  </Grid>
</ContentPage>