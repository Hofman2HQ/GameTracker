<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             x:Class="MyGameCatalog.Views.MainPage"
             Title="Game Catalog">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add Game" Clicked="OnAddGameClicked"/>
        <ToolbarItem Text="Refresh" Command="{Binding RefreshCommand}"/>
    </ContentPage.ToolbarItems>
    
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Search Section -->
        <StackLayout Grid.Row="0" Padding="10">
            <SearchBar Placeholder="Search games..."
                      Text="{Binding SearchQuery}"
                      SearchCommand="{Binding SearchCommand}"/>
        </StackLayout>

        <!-- Filter Section -->
        <HorizontalStackLayout Grid.Row="1" Padding="10" Spacing="10">
            <Label Text="Filter:" VerticalOptions="Center"/>
            <Picker Title="Select Status"
                    SelectedItem="{Binding SelectedFilter}"
                    ItemsSource="{Binding AvailableFilters}"/>
        </HorizontalStackLayout>

        <!-- Games Collection -->
        <CollectionView Grid.Row="2" 
                       ItemsSource="{Binding Games}"
                       SelectionMode="None"
                       RemainingItemsThreshold="5"
                       RemainingItemsThresholdReached="OnRemainingItemsThresholdReached">
            <CollectionView.EmptyView>
                <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="No games found"
                           HorizontalOptions="Center"
                           TextColor="Gray"/>
                </StackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="5" Padding="10" BorderColor="LightGray">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Image Source="{Binding CoverArtUrl}" 
                                   WidthRequest="60" 
                                   HeightRequest="60"
                                   Aspect="AspectFill"/>
                            <StackLayout Grid.Column="1" Margin="10,0">
                                <Label Text="{Binding Title}" 
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding Status}" 
                                       TextColor="Gray"
                                       FontSize="Small"/>
                            </StackLayout>
                            <Button Grid.Column="2" 
                                    Text="Details"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewDetailsCommand}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Loading and Error States -->
        <Grid Grid.Row="3" IsVisible="{Binding IsBusy}">
            <ActivityIndicator IsRunning="True" 
                             IsVisible="True"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"/>
        </Grid>

        <!-- Error Message -->
        <Frame Grid.Row="3" 
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
               BackgroundColor="#FFE0E0"
               BorderColor="#FF8080"
               Padding="10"
               Margin="10">
            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"/>
        </Frame>

        <!-- Load More Button -->
        <Button Grid.Row="3"
                Text="Load More"
                Command="{Binding LoadMoreCommand}"
                IsVisible="{Binding HasMoreItems}"
                Margin="10"/>
    </Grid>
</ContentPage>